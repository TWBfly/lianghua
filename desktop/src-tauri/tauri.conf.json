{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lianghua",
  "version": "1.0.0",
  "identifier": "com.lianghua.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "量化交易工作站",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 700,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
